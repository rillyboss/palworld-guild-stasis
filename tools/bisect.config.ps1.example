<#
  Copy to bisect.config.ps1 (gitignored) and fill in.

  BisectHosting uses SFTP (port 2022), not plain FTP, so set Protocol = sftp.
  The SFTP login lands directly in the game directory, so GameRoot is '.'.
  (Nitrado differs: plain FTP on 21, and GameRoot = 'palworld'.)

  Requires: Install-Module Posh-SSH -Scope CurrentUser
#>
@{
    Protocol = 'sftp'

    SftpHost = 'gamesdalXX.bisecthosting.com'
    SftpPort = 2022
    SftpUser = 'yourname.xxxxxxxx'
    SftpPass = 'CHANGEME'

    # SFTP login is already at the game root on Bisect.
    GameRoot = '.'

    # Palworld REST API. Port comes from RESTAPIPort in PalWorldSettings.ini,
    # and AdminPassword is host-generated - read it from that file rather than
    # assuming it matches your old host.
    RestBase      = 'http://X.X.X.X:9007'
    AdminPassword = 'CHANGEME'
}
